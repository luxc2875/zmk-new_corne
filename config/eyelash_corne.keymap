#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&soft_off { hold-time-ms = <2000>; };

&lt {
    tapping-term-ms = <100>;
    retro-tap;
};

&mt {
    retro-tap;
    flavor = "balanced";
    tapping-term-ms = <5000>;
    require-prior-idle-ms = <150>;
    hold-trigger-key-positions = <>;
};

&sk { quick-release; };

/ {
    behaviors {
        td_shift: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&sk LEFT_SHIFT>, <&caps_word>;
        };

        mtl: mtl {
            compatible = "zmk,behavior-hold-tap";
            label = "MTL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <7 7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        mtr: mtr {
            compatible = "zmk,behavior-hold-tap";
            label = "MTR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };

        homerow-tab {
            bindings = <&kp TAB>;
            key-positions = <15 16>;
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };

        hr-enter {
            bindings = <&kp ENTER>;
            key-positions = <23 24 25>;
            timeout-ms = <30>;
        };

        word-cap {
            bindings = <&caps_word>;
            key-positions = <18 22>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Gallium";
            bindings = <
&kp ESCAPE  &kp B            &kp L            &kp D                &kp C              &kp V                             &kp UP                &kp J         &kp Y               &kp O                 &kp U             &kp COMMA         &kp BSPC
&kp EQUAL   &mtl LEFT_GUI N  &mtl LEFT_ALT R  &mtl LEFT_CONTROL T  &mtl LEFT_SHIFT S  &kp G                   &kp LEFT  &kp ENTER  &kp RIGHT  &kp P         &mtr RIGHT_SHIFT H  &mtr RIGHT_CONTROL A  &mtr RIGHT_ALT E  &mtr RIGHT_GUI I  &kp SLASH
&kp MINUS   &kp X            &kp Q            &kp M                &kp W              &kp Z      &kp SPACE              &kp DOWN              &kp K         &kp F               &kp SQT               &kp SEMICOLON     &kp PERIOD        &kp BACKSLASH
                                              &lt 1 MINUS          &lt 4 ENTER        &td_shift                                               &lt 6 ESCAPE  &lt 5 SPACE         &lt 7 BACKSLASH
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        hardware {
            display-name = "HW";
            bindings = <
&trans  &kp N1           &kp N2          &kp N3        &kp N4        &kp N5                                         &mmv MOVE_UP                     &kp N6           &kp N7           &kp N8           &kp N9           &kp N0    &kp BSPC
&trans  &bt BT_CLR_ALL   &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3                   &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &kp HOME  &kp PG_UP
&trans  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &trans        &trans        &rgb_ug RGB_EFF  &kp C_MUTE                    &mmv MOVE_DOWN                   &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp END   &kp PG_DN
                                         &trans        &trans        &trans                                                                          &kp INS          &kp DEL          &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp EXCL      &kp AT        &kp HASH   &kp DLLR   &kp PRCNT                            &mmv MOVE_UP                     &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans  &bt BT_CLR    &mkp LCLK     &mkp MCLK  &mkp RCLK  &mkp MB4             &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &out OUT_USB  &out OUT_BLE  &none      &none      &mkp MB5   &trans                    &mmv MOVE_DOWN                   &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                    &trans     &trans     &kp SPACE                                                             &kp RET    &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
&studio_unlock  &kp F1      &kp F2     &kp F3       &kp F4     &kp F5                                  &mmv MOVE_UP                     &kp F6       &kp F7     &kp F8       &kp F9      &kp F10          &kp F11
&trans          &trans      &mkp LCLK  &mkp MCLK    &mkp RCLK  &mkp MB4                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &bootloader  &mkp LCLK  &mkp MCLK    &mkp RCLK   &kp PRINTSCREEN  &kp F12
&trans          &sys_reset  &trans     &bootloader  &trans     &mkp MB5  &kp C_MUTE                    &mmv MOVE_DOWN                   &trans       &trans     &bootloader  &sys_reset  &kp SCROLLLOCK   &kp PAUSE_BREAK
                                       &trans       &trans     &trans                                                                   &trans       &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        nav {
            bindings = <
&trans  &trans    &trans        &trans            &trans          &trans                    &trans          &trans    &kp K_PASTE    &kp K_COPY   &trans     &trans        &trans
&trans  &kp LGUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &sk LEFT_SHIFT  &trans            &trans  &trans  &trans  &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &kp CAPSLOCK  &trans
&trans  &trans    &trans        &trans            &trans          &trans  &trans            &trans          &trans    &kp PAGE_DOWN  &kp PAGE_UP  &trans     &trans        &trans
                                &trans            &trans          &trans                                    &trans    &trans         &trans
            >;

            label = "NAV";
        };

        num {
            bindings = <
&trans  &kp LEFT_BRACKET  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RIGHT_BRACKET                    &trans          &trans  &trans           &trans     &trans         &trans         &trans
&trans  &kp SEMICOLON     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL                    &trans  &trans  &trans  &trans  &sk RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
&trans  &kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH      &trans            &trans          &trans  &trans           &trans     &trans         &trans         &trans
                                        &kp PERIOD    &kp N0        &kp MINUS                                            &trans  &trans           &trans
            >;

            label = "NUM";
        };

        sym {
            bindings = <
&trans  &kp LEFT_BRACE  &kp AMPERSAND    &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp RIGHT_BRACE                    &trans          &trans  &trans           &trans     &trans         &trans         &trans
&trans  &kp COLON       &kp DOLLAR       &kp PERCENT           &kp CARET              &kp KP_PLUS                &trans  &trans  &trans  &trans  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
&trans  &kp TILDE       &kp EXCLAMATION  &kp AT_SIGN           &kp HASH               &kp PIPE         &trans            &trans          &trans  &trans           &trans     &trans         &trans         &trans
                                         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE                                     &trans  &trans           &trans
            >;

            label = "SYM";
        };

        fun {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8  &kp F9  &trans                    &trans          &trans  &trans           &trans     &trans         &trans         &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6  &trans            &trans  &trans  &trans  &trans  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &trans  &trans            &trans          &trans  &trans           &trans     &trans         &trans         &trans
                         &trans  &trans  &trans                                    &trans  &trans           &trans
            >;

            label = "FUN";
        };

        sym_assist {
            bindings = <
&trans  &trans    &trans        &trans     &trans     &trans                    &trans          &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR     &trans  &trans
&trans  &kp LGUI  &kp LEFT_ALT  &kp LCTRL  &kp LSHFT  &trans            &trans  &trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSLASH  &trans  &trans
&trans  &trans    &trans        &trans     &trans     &trans  &trans            &trans          &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans         &trans  &trans
                                &trans     &trans     &trans                                    &trans  &trans                &trans
            >;
        };
    };
};
